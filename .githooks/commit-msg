#!/usr/bin/env bash
# Enforces Conventional Commits, matching this repo's actual history
# (e.g. "fix(probe-runtime): ...", "build: ...", "docs: ..."). See docs/git-guide.md#commit-messages.
set -euo pipefail

MSG_FILE="$1"
SUBJECT="$(head -n1 "$MSG_FILE")"

# Merge commits and fixups are exempt.
case "$SUBJECT" in
  "Merge "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

PATTERN='^(feat|fix|build|chore|refactor|docs|test|perf|ci|style|revert)(\([a-zA-Z0-9_.-]+\))?: .+'

if ! [[ "$SUBJECT" =~ $PATTERN ]]; then
  cat >&2 <<EOF
commit-msg: subject line doesn't follow Conventional Commits:

  "$SUBJECT"

Expected: <type>(<optional scope>): <subject>
  type one of: feat fix build chore refactor docs test perf ci style revert
  example:     fix(probe-runtime): guard ProbeActivity against a disabled runtime

See docs/git-guide.md#commit-messages. Bypass once with 'git commit --no-verify' if this
really doesn't fit (e.g. an automated merge).
EOF
  exit 1
fi
