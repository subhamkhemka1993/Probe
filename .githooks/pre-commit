#!/usr/bin/env bash
# Fast, local guardrails run before every commit. See docs/git-guide.md#hooks.
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! scripts/check-branch-name.sh; then
  exit 1
fi

# Non-negotiable: no sanctioned bypass (no SKIP_* var) for AI-authorship attribution.
if ! scripts/check-no-ai-attribution.sh --staged; then
  echo "pre-commit: blocked by AI-attribution check (see above)." >&2
  exit 1
fi

if ! scripts/check-lint-guardrails.sh; then
  echo "pre-commit: blocked by lint guardrails check (see above)." >&2
  exit 1
fi

# Non-negotiable: no sanctioned bypass (no SKIP_* var) for mid-block comments.
if ! scripts/check-no-midblock-comments.sh --staged; then
  echo "pre-commit: blocked by mid-block comment check (see above)." >&2
  exit 1
fi

STAGED_KOTLIN="$(git diff --cached --name-only --diff-filter=ACM -- '*.kt' '*.kts' || true)"

if [ -n "$STAGED_KOTLIN" ]; then
  echo "pre-commit: formatting staged Kotlin files with Spotless..."
  ./gradlew --quiet spotlessApply
  # Re-stage anything Spotless reformatted so the formatted version is what gets committed.
  printf '%s\n' "$STAGED_KOTLIN" | xargs -r git add
fi

if [ "${SKIP_DOCS_CHECK:-0}" != "1" ]; then
  if ! scripts/check-docs-freshness.sh --staged; then
    echo "pre-commit: blocked by docs-freshness check (see above)." >&2
    exit 1
  fi
fi
